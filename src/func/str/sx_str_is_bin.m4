M_REQUIRE([|__sx_str_is_bin|])dnl
### sx_str_is_bin - すべての引数が2進数字（0, 1）のみで構成されているか確認する
##
## 使い方:
##   sx_str_is_bin [文字列1 [文字列2 ...]]
##
## 説明:
##   実処理は内部関数 __sx_str_is_bin に委譲する。
##   先頭ゼロと任意の桁数を許容する。接頭辞、符号、空白は許容しない。
##   引数がない場合は成功する。
##
## 終了ステータス:
##    0  すべて2進数字のみで構成されている、または引数なし (SX_EX_OK)
##    1  2進数字以外が含まれる、または空文字列が含まれる

sx_str_is_bin() {
	M_CFG_CHECK([|sx_str_is_bin|])

	__sx_str_is_bin "${@}" || return
}
